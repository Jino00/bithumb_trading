# 빗썸 API (페이퍼 트레이딩은 없어도 됨, 실전용)
BITHUMB_API_KEY=
BITHUMB_SECRET_KEY=

# Gemini API (외부 인사이트용)
GEMINI_API_KEY=your_gemini_api_key_here

# 텔레그램 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 페이퍼 트레이딩 설정
PAPER_TRADING=true
PAPER_INITIAL_KRW=10000000000

# 슬롯 설정
MAX_POSITIONS=70
EXPLORATION_ENABLED=true
